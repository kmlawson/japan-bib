# Whitelist: only the browser, the database and the build scripts are published.
# PDFs/EPUBs, page transcriptions (raw data from the books), caches and work logs stay local.
/*
!/.gitignore
!/README.md
!/index.html
!/list.sqlite
!/vendor/
!/union-catalog-work/
/union-catalog-work/*
!/union-catalog-work/build_db.py
!/union-catalog-work/build_list.py
!/union-catalog-work/ia_lookup.py
!/union-catalog-work/validate.py
!/union-catalog-work/loose_lookup.py
!/union-catalog-work/loose_classify.py
!/union-catalog-work/loose_decide.py
!/next-bib-work/
/next-bib-work/*
!/next-bib-work/merge.py
!/next-bib-work/ia_lookup2.py
!/next-bib-work/validate2.py
!/next-bib-work/ia_access/
/next-bib-work/ia_access/*
!/next-bib-work/ia_access/check_access.py
!/onlinebooks-work/
/onlinebooks-work/*
!/onlinebooks-work/ob_search.py
!/ndl-work/
/ndl-work/*
!/ndl-work/ndl_fetch.py
!/ndl-work/ndl_merge.py
!/ndl-work/ndl_access.py
!/zotero-work/
/zotero-work/*
!/zotero-work/zotero_parse.py
!/zotero-work/zotero_merge.py
*.pdf
*.epub
.DS_Store
__pycache__/
