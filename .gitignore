# Whitelist: only the browser, the database and the build scripts are published.
# PDFs/EPUBs, page transcriptions (raw data from the books), caches and work logs stay local.
/*
!/.gitignore
!/README.md
!/DEPLOY.md
!/index.html
!/build_page.py
!/build_downloads.py
!/page/
/page/*
!/page/modern-japan.md
!/page/version.txt
!/site/
/site/*
!/site/app.css
!/site/app.html
!/site/app.js
!/site/page.css
!/list.sqlite
!/vendor/
!/union-catalog-work/
/union-catalog-work/*
!/union-catalog-work/build_db.py
!/union-catalog-work/build_list.py
!/union-catalog-work/ia_lookup.py
!/union-catalog-work/validate.py
!/union-catalog-work/language.py
!/union-catalog-work/language_fixes.tsv
!/union-catalog-work/loose_lookup.py
!/union-catalog-work/loose_classify.py
!/union-catalog-work/loose_decide.py
!/next-bib-work/
/next-bib-work/*
!/next-bib-work/merge.py
!/next-bib-work/ia_lookup2.py
!/next-bib-work/validate2.py
!/next-bib-work/ia_access/
/next-bib-work/ia_access/*
!/next-bib-work/ia_access/check_access.py
!/onlinebooks-work/
/onlinebooks-work/*
!/onlinebooks-work/ob_search.py
!/onlinebooks-work/ob_score.py
!/onlinebooks-work/ob_merge.py
!/onlinebooks-work/ob_decisions.tsv
!/extra-work/
/extra-work/*
!/extra-work/extra_fetch.py
!/extra-work/extra_merge.py
!/extra-work/ids.txt
!/libraries-work/
/libraries-work/*
!/libraries-work/lib_fetch.py
!/libraries-work/lib_merge.py
!/libraries-work/ids.txt
!/asj-work/
/asj-work/*
!/asj-work/asj_merge.py
!/asj-work/ia_lookup4.py
!/asj-work/validate4.py
!/asj-work/AGENT_BRIEF.md
!/asj-work/japan_decided.tsv
!/bje-work/
/bje-work/*
!/bje-work/bje_merge.py
!/bje-work/ia_lookup5.py
!/bje-work/validate5.py
!/bje-work/AGENT_BRIEF.md
!/nichibun-work/
