!/hispana-work/hispana_search.py
!/hispana-work/hispana_links.py
!/hispana-work/hispana_merge.py
!/hispana-work/hispana_decisions.tsv
!/bne-work/
/bne-work/*
!/bne-work/chrome.py
!/bne-work/bne_search.py
!/union-catalog-work/title_fixes.tsv
!/ndl-work/
/ndl-work/*
!/ndl-work/ndl_fetch.py
!/ndl-work/ndl_merge.py
!/ndl-work/ndl_access.py
!/zotero-work/
/zotero-work/*
!/zotero-work/zotero_parse.py
